rules_version = '2';
// Règles de sécurité Firestore des Lanternes de Nour — À TESTER DANS L'ÉMULATEUR AVANT TOUTE ACTIVATION.
//
// Architecture retenue : le navigateur ne lit et n'écrit JAMAIS directement dans Firestore.
// Toutes les opérations passent par le serveur (Cloudflare Worker, serveur/api.js), qui vérifie la session,
// calcule les droits (serveur/droits.js) et utilise un compte de service (qui n'est pas soumis à ces règles).
// Donc : tout est refusé à tous les clients, sans exception. Aucun rôle, droit, abonnement, invitation,
// profil enfant ou journal ne peut être lu ou modifié depuis un navigateur.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
