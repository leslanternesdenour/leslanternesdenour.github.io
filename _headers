# En-têtes HTTP de sécurité (Cloudflare Pages). Ignoré par GitHub Pages.
# Chaque domaine externe autorisé est réellement utilisé par le site (voir 3_ARCHITECTURE_TECHNIQUE.md § 1).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://yt3.googleusercontent.com; media-src 'self' data: blob: https://cdn.islamic.network; connect-src 'self' https://cdn.jsdelivr.net https://api.alquran.cloud https://cdn.islamic.network https://www.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src 'self' https://www.youtube-nocookie.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Médias lourds (voix, images) : gardés 1 heure par le navigateur au lieu d'être revalidés à chaque lecture.
# Une heure seulement : une voix ou une image corrigée apparaît vite. HTML, JS, CSS et JSON restent toujours revalidés.
/*.mp3
  Cache-Control: public, max-age=3600
/*.webp
  Cache-Control: public, max-age=3600
/*.png
  Cache-Control: public, max-age=3600
/*.jpg
  Cache-Control: public, max-age=3600
/*.svg
  Cache-Control: public, max-age=3600
/*.glb
  Cache-Control: public, max-age=3600

# Le service worker du calendrier doit toujours être relu
/calendrier/sw.js
  Cache-Control: no-cache

# Espaces privés : jamais indexés, jamais gardés en cache (navigateur ni intermédiaires)
# Pages où l'on se connecte (Google s'ouvre dans une fenêtre) : CSP élargie de DEUX sources seulement — le script de connexion Google (apis.google.com) et la page de connexion du projet Firebase (cadre).
# Le reste du site garde la CSP stricte. « ! » retire la CSP héritée de /* : sans cela deux CSP s'appliqueraient ensemble et la plus stricte l'emporterait.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://yt3.googleusercontent.com; media-src 'self' data: blob: https://cdn.islamic.network; connect-src 'self' https://cdn.jsdelivr.net https://api.alquran.cloud https://cdn.islamic.network https://www.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src 'self' https://www.youtube-nocookie.com https://lanternes-de-nour.firebaseapp.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/compte/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://yt3.googleusercontent.com; media-src 'self' data: blob: https://cdn.islamic.network; connect-src 'self' https://cdn.jsdelivr.net https://api.alquran.cloud https://cdn.islamic.network https://www.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src 'self' https://www.youtube-nocookie.com https://lanternes-de-nour.firebaseapp.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Robots-Tag: noindex, nofollow
